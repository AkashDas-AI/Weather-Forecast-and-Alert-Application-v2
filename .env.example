# Environment Configuration Example
# Copy this file to .env and adjust values as needed.
# Never commit .env or real API keys to version control.

# Weather provider selection (default: open-meteo; no API key required for standard non-commercial use)
WEATHER_PROVIDER=open-meteo

# Forecast & unit defaults
DEFAULT_TIMEZONE=auto
FORECAST_DAYS=7
TEMPERATURE_UNIT=celsius
WIND_SPEED_UNIT=kmh
PRECIPITATION_UNIT=mm

# Default location settings
DEFAULT_CITY=Kolkata

# Application settings
LOG_LEVEL=INFO
DATABASE_PATH=outputs/weather_data.db
