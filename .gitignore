# Virtual environment
.venv/

# Environment variables & secrets
.env
.env.*
!.env.example

# Python cache & build artifacts
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
dist/
build/

# Testing, coverage & linters
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/
.tox/
.nox/

# Temporary files
*.tmp
*.temp

# Local databases
*.db
*.sqlite
*.sqlite3

# Generated outputs (keep directory structure via .gitkeep)
outputs/charts/*
!outputs/charts/.gitkeep
outputs/exports/*
!outputs/exports/.gitkeep
outputs/logs/*
!outputs/logs/.gitkeep

# OS & editor files
.DS_Store
Thumbs.db
.vscode/
.idea/

# Personal / local-only documentation (never push to GitHub)
docs/INTERVIEW_PREPARATION.md
docs/LOCAL_CLEANUP_AND_RESTORATION.md
